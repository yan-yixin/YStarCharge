@model YStarCharge.Web.Models.UserAccount
@{
    ViewData["Title"] = "注册新用户";
}

<div class="container-fluid m-5">
    <div class="col-md-4 offset-4 border rounded-3 border-dark p-3 ">
        <form asp-controller="Login" asp-action="Index">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group m-5">
                <p ></p>
            </div>
            <div class="form-group m-5">
                <p class="text-secondary text-lg-center">注册</p>
            </div>
            <div class="form-group m-3">
                <label asp-for="Username" class="control-label small"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group m-3">
                <label asp-for="Password" class="control-label small"></label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group mt-4 mb-4 mx-3 my-3">
                <input type="submit" value="注册" class="btn btn-dark form-control" />
            </div>
        </form>
    </div>

</div>
