<UserControl x:Class="YStarCharge.Document.StatisticsDoucment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YStarCharge.Document"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid  Grid.Row="0" Margin="0,0,0,5">
            <GroupBox Header="查询条件" Foreground="White" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="年份："/>
                    <TextBox x:Name="yearTextBox" Text="2022" Width="80" Height="20" 
                             Background="Transparent" 
                             Foreground="White" TextAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Name="fliterComboBox" Foreground="White" Margin="10,0"/>
                    <ComboBox Name="expendComboBox" Foreground="White" Margin="10,0,20,0"/>
                    <Border CornerRadius="5"  Width="80" Height="30" BorderThickness="1" BorderBrush="White">
                        <Button Content="查询" 
                                Background="Transparent" Foreground="{StaticResource AppBackground}" 
                                BorderThickness="0"
                                Command="{Binding Query}"/>
                    </Border>
                </StackPanel>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="1" Name="chartGrid">
            
        </Grid>
    </Grid>
</UserControl>
